# =============================================================
# SatQuery — Environment Configuration
# =============================================================
# Copy to .env and adjust values for your environment.

# Mock mode: when true, all tools return realistic mock outputs.
# Set to false when real Person 2/3 models are integrated.
SATQUERY_MOCK_MODE=true
# Inference Mode: quantized-4bit, cpu-offload, full-fp16, gguf
SATQUERY_MODE=cpu-offload

# API Keys
# Required for the LLM orchestration (Router & Planner)
GEMINI_API_KEY="your_api_key_here"

# Logging
SATQUERY_LOG_LEVEL=INFO

# Directories
SATQUERY_UPLOAD_DIR=./uploads
SATQUERY_ARTIFACTS_DIR=./artifacts
DATASET_ROOT=datasets
CHECKPOINT_DIR=models/checkpoints
OUTPUT_DIR=./outputs

# Limits
SATQUERY_MAX_IMAGE_SIZE_MB=500

# HuggingFace & Model Config
HF_TOKEN=your_huggingface_token_here
HF_HUB_REPO=your-username/satquery-rs-vlm
GEOCHAT_BASE_MODEL=MBZUAI/geochat-7B
LORA_ADAPTER_PATH=models/checkpoints/satquery-rs-vlm
VISION_TOWER=openai/clip-vit-large-patch14-336
DEVICE_MAP=auto
DEVICE=cuda

# Training (cloud only)
WANDB_PROJECT=satquery-rs
WANDB_API_KEY=your_wandb_key_here
