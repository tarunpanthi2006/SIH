# =============================================================
# SatQuery — Environment Configuration
# =============================================================
# Copy to .env and adjust values for your environment.

# Mock mode: when true, all tools return realistic mock outputs.
# Set to false when real Person 2/3 models are integrated.
SATQUERY_MOCK_MODE=true

# API Keys
# Required for the LLM orchestration (Router & Planner)
GEMINI_API_KEY="your_api_key_here"

# Logging
SATQUERY_LOG_LEVEL=INFO

# Directories
SATQUERY_UPLOAD_DIR=./uploads
SATQUERY_ARTIFACTS_DIR=./artifacts

# Limits
SATQUERY_MAX_IMAGE_SIZE_MB=500

GEMINI_API_KEY="AQ.Ab8RN6Ju9dYtm0as0D7Zsvwkl4acQ8P4um-MIboiiB9TyNFupw"
