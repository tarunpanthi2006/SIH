# ============================================================
# SatQuery .gitignore
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ----- Virtual Environment -----
.venv/
venv/
env/
ENV/

# ----- Environment & Secrets -----
.env
*.env
!.env.example

# ----- Model Weights (DO NOT COMMIT) -----
models/checkpoints/
models/weights/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.ggml

# ----- Datasets (DO NOT COMMIT) -----
datasets/bigearthnet/raw/
datasets/bigearthnet/images/
datasets/bigearthnet/processed/
datasets/vrsbench/images/
datasets/rsvqa/images/
datasets/rsvqa/data/
datasets/cdvqa/images/
datasets/levir_cd/images/
datasets/levir_cc/images/
*.parquet
*.h5
*.hdf5
*.tif
*.tiff
*.nc

# ----- Training Outputs -----
training/finetuning/runs/
training/finetuning/logs/
wandb/
runs/
outputs/
lightning_logs/

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Jupyter -----
.ipynb_checkpoints/
*.ipynb

# ----- System -----
*.log
*.tmp
*.bak

# ----- HuggingFace cache -----
.cache/
